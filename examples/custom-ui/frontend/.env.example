# Local development config for `npm run dev`.
# In a deployed environment these values are served at runtime from /config.json
# by the Go Lambda (populated from Terraform), so you do NOT rebuild to change them.
# Copy this file to .env.local for local development.

VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_REGION=us-east-1

# Optional: used only by the Config page to show how to wire this app into the
# Federation Gateway as a custom login page.
VITE_GATEWAY_BASE_URL=https://gateway.example.com
VITE_GATEWAY_TENANT=demo

# Optional (all default to hidden/off): social-login + passkey affordances on /login.
# Leave unset to keep the login page a plain SRP email/password form.
#
# VITE_COGNITO_DOMAIN: the Cognito user-pool domain used to build /oauth2/authorize
# URLs for the social-login buttons. Required for the social section to appear.
# VITE_COGNITO_DOMAIN=example.auth.us-east-1.amazoncognito.com
#
# VITE_SOCIAL_IDPS: a JSON array of { "label", "idp", "color"? } objects. `idp` is the
# exact Cognito identity-provider name. The social section shows only when this is a
# non-empty array AND VITE_COGNITO_DOMAIN is set. Malformed JSON is ignored (section hidden).
# VITE_SOCIAL_IDPS=[{"label":"Google","idp":"Google","color":"#4285f4"},{"label":"Apple","idp":"SignInWithApple"}]
#
# VITE_PASSKEYS_ENABLED: set to "true" to show the WebAuthn passkey button. The button is
# still disabled when the browser lacks WebAuthn support. Any other value keeps it off.
# VITE_PASSKEYS_ENABLED=true
